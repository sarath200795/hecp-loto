# Copy this file to .env.local and fill in values from your Firebase project
# (Firebase Console -> Project settings -> General -> Your apps -> SDK setup & configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: only if you use a NAMED Firestore database instead of "(default)".
# Leave blank to use the default database (what the standard config expects).
VITE_FIREBASE_FIRESTORE_DB=

# Optional: enable Firebase App Check (reCAPTCHA v3). Register the site in
# Firebase Console -> App Check, then set the reCAPTCHA v3 site key here.
# Leave blank to disable App Check (default).
VITE_FIREBASE_RECAPTCHA_KEY=

# Optional: session/inactivity timeout. Defaults: 30 min idle, 60s warning.
VITE_SESSION_IDLE_MINUTES=30
VITE_SESSION_WARN_SECONDS=60
