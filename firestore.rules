rules_version = '2';

// ---------------------------------------------------------------------------
// HECP / LOTO — Phase 1 security rules.
// Enforces multi-tenant isolation (per orgId) and admin-only user management.
// NOTE: organizations are readable by any signed-in user so the signup flow
// can resolve a join code. A later phase will replace this with a callable
// Cloud Function and lock organization reads to members only.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function meExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Current user is an approved admin (holds users.manage) in the given org.
    function isOrgManager(orgId) {
      return signedIn()
        && meExists()
        && me().orgId == orgId
        && me().status == 'approved'
        && ('users.manage' in me().permissions);
    }

    function isApprovedMember() {
      return signedIn() && meExists() && me().status == 'approved';
    }

    function hasPerm(p) {
      return isApprovedMember() && (p in me().permissions);
    }

    match /organizations/{orgId} {
      // Public so the signup org dropdown can load before the user authenticates.
      allow read: if true;
      // Creator stamps themselves as createdBy; that powers the admin-user check.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false; // not editable from the client in phase 1
    }

    match /users/{uid} {
      // Own doc always; other docs only within the same organization.
      allow read: if signedIn() && (
        request.auth.uid == uid
        || (meExists() && me().orgId == resource.data.orgId)
      );

      // Self-creation only, and either:
      //  - joining as a pending member (no role/permissions), or
      //  - creating the org as its admin (verified via the org's createdBy
      //    written in the same transaction).
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.orgId is string
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.role == null
            && request.resource.data.permissions.size() == 0
          )
          || (
            request.resource.data.status == 'approved'
            && request.resource.data.role == 'admin'
            && getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.createdBy == request.auth.uid
          )
        );

      // Only an org manager may change another member's role/status/permissions,
      // and may never move a user to a different organization.
      allow update: if isOrgManager(resource.data.orgId)
        && request.auth.uid != uid
        && request.resource.data.orgId == resource.data.orgId;

      allow delete: if false;
    }

    match /procedures/{pid} {
      // Single-doc reads are public so a scanned QR code shows the procedure
      // without login (perform actions still require auth + permission).
      allow get: if true;
      // Listing/querying is restricted to members of the procedure's org.
      allow list: if isApprovedMember() && resource.data.orgId == me().orgId;

      allow create: if isApprovedMember()
        && request.resource.data.orgId == me().orgId
        && hasPerm('procedure.create');

      // Coarse-grained: any approved member of the org holding a relevant
      // permission may update (revise / approve / send / lock-out). The UI
      // enforces which action each role performs; org + approval are hard
      // requirements here, and orgId can never change.
      allow update: if isApprovedMember()
        && resource.data.orgId == me().orgId
        && request.resource.data.orgId == resource.data.orgId
        && (
          hasPerm('procedure.revise')
          || hasPerm('procedure.approve')
          || hasPerm('procedure.sendForApproval')
          // Performing LOTO (lock/unlock) is only allowed on APPROVED procedures.
          || (hasPerm('loto.perform') && resource.data.status == 'approved')
        );

      allow delete: if isApprovedMember()
        && resource.data.orgId == me().orgId
        && hasPerm('procedure.delete');
    }

    // Authorized LOTO technicians (name + dedicated lock no.). Admin-managed.
    match /technicians/{id} {
      allow read: if isApprovedMember() && resource.data.orgId == me().orgId;
      allow create: if isApprovedMember()
        && request.resource.data.orgId == me().orgId
        && ('users.manage' in me().permissions);
      allow update, delete: if isApprovedMember()
        && resource.data.orgId == me().orgId
        && ('users.manage' in me().permissions);
    }

    // Lock inventory (physical locks: lock no. + type). Admin-managed.
    match /locks/{id} {
      allow read: if isApprovedMember() && resource.data.orgId == me().orgId;
      allow create: if isApprovedMember()
        && request.resource.data.orgId == me().orgId
        && ('users.manage' in me().permissions);
      allow update, delete: if isApprovedMember()
        && resource.data.orgId == me().orgId
        && ('users.manage' in me().permissions);
    }

    // Append-only LOTO activity log (audit trail). Never editable/deletable.
    match /lotoEvents/{id} {
      allow read: if isApprovedMember() && resource.data.orgId == me().orgId;
      allow create: if isApprovedMember()
        && request.resource.data.orgId == me().orgId
        && hasPerm('loto.perform');
      allow update, delete: if false;
    }

    // Isolation-point photos (compressed data URLs), stored separately from the
    // main procedure doc so list/dashboard reads stay light.
    match /procedurePhotos/{pid} {
      allow get: if true; // public so the QR scan view can show photos
      allow list: if false;
      allow create, update: if isApprovedMember()
        && request.resource.data.orgId == me().orgId
        && (hasPerm('procedure.create') || hasPerm('procedure.revise'));
      allow delete: if isApprovedMember()
        && resource.data.orgId == me().orgId
        && hasPerm('procedure.delete');
    }

    // Everything else is denied until later phases add their own rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
